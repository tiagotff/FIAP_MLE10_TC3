# Caminhos de dados e artefatos
DATA_RAW_DIR=data/raw
MODELS_DIR=models
MODEL_FILENAME=model.joblib
ONNX_FILENAME=model.onnx
REPORTS_DIR=reports
ARTIFACTS_DIR=artifacts

# Configurações declarativas
DATA_CONFIG_PATH=configs/data.yaml
MODEL_CONFIG_PATH=configs/model.yaml
TRAINING_CONFIG_PATH=configs/training.yaml
TUNING_CONFIG_PATH=configs/tuning.yaml

# Reprodutibilidade
RANDOM_SEED=42

# Serviço de inferência
#   sklearn -> modelo original (models/model.joblib)
#   onnx    -> modelo otimizado (models/model.onnx); gere com
#              python -m triage.optimization.export_onnx
# A imagem Docker já usa onnx por padrão.
INFERENCE_BACKEND=sklearn
PORT=8000
LOG_LEVEL=INFO
